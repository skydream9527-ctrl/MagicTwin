# ============================================================
# MagicTwin · 环境变量示例
# 使用方法：cp .env.example .env，然后填入你自己的值
# 服务端启动时会按以下顺序自动探测，未配置的会优雅降级（见 README「降级策略」）
# ============================================================

# ---------- HTTP 服务 ----------
PORT=8787
# 默认绑定浏览器使用的 localhost；需要局域网访问时显式改为 0.0.0.0
HOST=localhost

# ---------- LLM 网关（OpenAI 兼容） ----------
# openai：调用真实 OpenAI 兼容网关；mock：完全离线演示，无需 API key
LLM_BACKEND=mock
# 把 LLM_BASE_URL 设成你的 OpenAI 兼容端点（如 https://api.openai.com/v1）
# model 名格式取决于你的网关：OpenAI 原生用 "gpt-4o"，支持 {owner}/{id} 的网关用 "openai/gpt-4o"
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
# 网关不支持 GET /models 时，可显式列出前端允许选择的模型（英文逗号分隔）
# LLM_MODELS=gpt-4o,gpt-4o-mini

# ---------- 多供应商路由（可同时开启） ----------
# 开启真实调用时设 LLM_BACKEND=multi。密钥只应写入服务器的私密 .env，不要提交到 Git。
# MiniMax OpenAI 兼容端点
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
# MINIMAX_MODELS=MiniMax-M3,MiniMax-M2.7,MiniMax-M2.7-highspeed
# 火山引擎方舟 OpenAI 兼容端点
VOLCENGINE_API_KEY=
VOLCENGINE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# VOLCENGINE_MODELS=doubao-seed-2-0-lite-260215,doubao-seed-2-0-pro-260215
# Coding Plan 用户应改用套餐专用端点与模型名（不要填在线推理的日期型 Model ID）：
# VOLCENGINE_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
# VOLCENGINE_MODELS=doubao-seed-2.1-turbo,doubao-seed-2.0-code,doubao-seed-2.0-pro,doubao-seed-2.0-lite,doubao-seed-code,glm-5.2,kimi-k2.7-code,minimax-m3,deepseek-v4-flash,deepseek-v4-pro,minimax-m2.7,kimi-k2.6,ark-code-latest
# 所有 Agent 未单独配置时的默认模型（页面保存的选择优先）
# DEFAULT_MODEL=minimax/MiniMax-M2.7

# ---------- 三个角色的模型 ----------
# 模型名格式取决于你的 LLM 网关：OpenAI 原生用 "gpt-4o"，支持 {owner}/{id} 的网关用 "openai/gpt-4o"
# 任意 roster 中登记的 Agent 都可通过 <KEY_UPPER>_MODEL 配置：
#   TWIN_MODEL / RESEARCHER_MODEL / CONCEPT_MODEL / CRITIC_MODEL /
#   DATA_MODEL / STYLE_MODEL / GENERAL_MODEL / CODE_RUNNER_MODEL /
#   REPORT_WRITER_MODEL / DATA_MONITOR_MODEL
# Mock 模式无需指定模型；切换到 openai 后可按需取消注释。
# TWIN_MODEL=gpt-4o
# DATA_MODEL=gpt-4o
# STYLE_MODEL=gpt-4o

# ---------- LLM 调用参数 ----------
MAX_TOKENS=4000
MAX_STEPS=28
MAX_PARALLEL_AGENTS=6
MAX_PARALLEL_ROUNDS=5
LLM_TIMEOUT_MS=1800000

# ---------- 任务后处理与跨任务记忆 ----------
# smoke test 会临时关闭这两项，避免测试数据进入长期记忆；正常使用保持开启
POST_DELIVERY_LEARNING_ENABLED=1
MIRROR_AGENT_MEMORY=1

# ---------- 数据查询适配器（可选） ----------
# 默认 sample 演示模式（返回示例数据，编排始终可运行）。
# 接入真实数据源：设 QUERY_BACKEND=command + QUERY_COMMAND="your-cli {sql}"
# your-cli 需输出 JSON：{columns:[{name,type}], rows:[[...]]}
QUERY_BACKEND=sample
QUERY_ROW_LIMIT=2000

# ---------- 代码执行沙箱（可选；code-runner Agent 用） ----------
# 默认禁用（code-runner 调 execute 会返回 SANDBOX_DISABLED，编排自动改用 query 路径）
# 开发环境：SANDBOX_ENABLED=1 + SANDBOX_PYTHON=python3（直接本机执行，仅建议本地开发）
# 生产环境：SANDBOX_ENABLED=1 + SANDBOX_COMMAND="docker run --rm -i --network=none
#            --memory=512m --cpus=1 python:3.12-slim"（Docker 隔离，禁网 + 资源限额）
SANDBOX_ENABLED=0
# SANDBOX_PYTHON=python3
# SANDBOX_COMMAND=docker run --rm -i --network=none --memory=512m --cpus=1 python:3.12-slim
SANDBOX_TIMEOUT_MS=30000
SANDBOX_MAX_OUTPUT=20000
